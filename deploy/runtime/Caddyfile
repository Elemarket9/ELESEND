{$ELESEND_API_HOST} {
  encode gzip
  @blocked path /api/v1/debug* /api/v1/admin* /admin* /.env*
  respond @blocked 404
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    -Server
  }
  reverse_proxy api:3090 {
    health_uri /health
    transport http {
      dial_timeout 5s
      response_header_timeout 15s
    }
  }
}

# Web return pages and the restaurant portal.
{$WEB_HOST} {
  encode gzip
  @blocked path /api/v1/debug* /api/v1/admin* /admin* /.env*
  respond @blocked 404
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    -Server
  }
  reverse_proxy api:3090
}

{$ADMIN_HOST} {
  encode gzip
  # Set ADMIN_ALLOWED_IPS to your office or VPN addresses to close the admin portal to everyone else.
  @outside not remote_ip {$ADMIN_ALLOWED_IPS}
  respond @outside 404
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    -Server
  }
  @blocked path /api/v1/debug* /.env*
  respond @blocked 404
  reverse_proxy api:3090
}

# Public map tiles. Tiles are already compressed.
{$MAPS_HOST} {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }
  reverse_proxy maps:3145
}
