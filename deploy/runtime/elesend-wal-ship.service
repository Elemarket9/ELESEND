[Unit]
Description=Ship ELESEND database change files offsite
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/elesend/backup.env
ExecStart=/usr/bin/env bash -c '"${ELESEND_ROOT:?Set ELESEND_ROOT in /etc/elesend/backup.env}/deploy/runtime/wal-ship.sh"'
Nice=10
IOSchedulingClass=best-effort
