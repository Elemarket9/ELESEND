# Copy to /etc/elesend/backup.env (chmod 600). Used by the elesend-*.timer jobs. Then:
#   sudo cp deploy/runtime/elesend-*.{service,timer} /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now elesend-wal-ship.timer elesend-base-backup.timer elesend-backup.timer \
#        elesend-backup-verify.timer elesend-storage-check.timer
#   systemctl list-timers 'elesend-*'      # shows when each one last ran and runs next
ELESEND_ROOT=/opt/elesend
ELESEND_ENV_FILE=/opt/elesend/.env.runtime
# Storage at a different provider from the server (rclone remote, for example b2:elesend-backups).
OFFSITE_RCLONE_REMOTE=
# Root-only file holding a long random passphrase. Keep a copy somewhere safe away from the server:
# without it no backup can be decrypted.
GPG_PASSPHRASE_FILE=/etc/elesend/backup.passphrase
BACKUP_RETENTION_DAYS=30
# Monitoring "check" URLs (for example from healthchecks.io), one per job. Each job pings when it succeeds; the
# service alerts you when a ping is late or reports failure. Set the expected periods to match the timers.
WAL_HEARTBEAT_URL=
BASE_BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=
VERIFY_HEARTBEAT_URL=
STORAGE_HEARTBEAT_URL=
# For the weekly restore drill when the database runs elsewhere (optional).
VERIFY_PG_SUPER_URL=
