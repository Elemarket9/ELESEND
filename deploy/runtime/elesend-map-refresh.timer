[Unit]
Description=Daily ELESEND map refresh (roads, map tiles and searchable places)

[Timer]
# Geofabrik publishes a new Ghana extract every day. 02:30 Accra time is the quietest hour for deliveries.
OnCalendar=*-*-* 02:30
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
