# ELESEND Production Runtime Environment Template
# Copy to .env.runtime (or .env) and protect with: chmod 600 .env.runtime
# Never commit real credentials to version control.

# --- Domains & Origins (HTTPS Required in Production) ---
ELESEND_API_HOST=api.your-elesend-domain.example
ADMIN_HOST=admin.your-elesend-domain.example
API_PUBLIC_ORIGIN=https://api.your-elesend-domain.example
WEB_PUBLIC_ORIGIN=https://your-elesend-domain.example

# --- Database & TLS/SSL ---
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DOCKER_DATABASE_URL=postgres://elesend:URLENCODE_PASSWORD@db:5432/elesend
# Set to 'true' or 'require' when connecting to an external PostgreSQL instance over network TLS
DATABASE_SSL=false
# Preferred security standard: provide path to CA cert bundle (e.g. /etc/ssl/certs/ca-certificates.crt)
DATABASE_SSL_CA=
# Keep true to prevent Man-In-The-Middle attacks
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Independent Cryptographic Secrets (Each must be unique) ---
# Exactly 64 hexadecimal characters (32 bytes)
OTP_KEY=REPLACE_WITH_64_HEX_CHARS
ADMIN_MFA_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARS
# Minimum 32 characters each
JWT_SECRET=REPLACE_WITH_UNIQUE_32_CHAR_JWT_SECRET
ADMIN_MASTER_KEY=REPLACE_WITH_UNIQUE_32_CHAR_ADMIN_MASTER_KEY
AUDIT_LOG_SECRET=REPLACE_WITH_UNIQUE_32_CHAR_AUDIT_LOG_SECRET

# --- Server & Network ---
PORT=3090
HOST=0.0.0.0
# Restrict X-Forwarded-For trust to the single internal Caddy reverse proxy IP
TRUSTED_PROXY_CIDRS=172.29.240.10/32
# Optional 32+ char monitoring secret for GET /ready (header: X-Elesend-Health-Token)
READINESS_PROBE_TOKEN=

# --- Background Worker Execution ---
# Set to true when running background jobs inside the API process, or false when running 'npm run worker' separately
BACKGROUND_JOBS_ENABLED=true

# --- Routing Engine & Vehicle Profiles ---
# Self-hosted OSRM endpoints
ROUTING_OSRM_URL=http://osrm:5000
ROUTING_OSRM_MOTORCYCLE_URL=
ROUTING_OSRM_CAR_URL=
ROUTING_OSRM_PROFILES_JSON={"car":"driving","motorcycle":"driving"}
ROUTING_ALLOW_SINGLE_ENDPOINT=true

# --- Payment Provider Selection & Credentials ---
# Valid options: 'hubtel' | 'paystack' | 'gateway' | 'none' | 'auto'
PAYMENT_PROVIDER=none

# Hubtel Credentials (if PAYMENT_PROVIDER=hubtel or SMS_PROVIDER=hubtel)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
HUBTEL_SENDER_ID=ELESEND
HUBTEL_SMS_ENDPOINT=https://api.hubtel.com/v1/messages/send
HUBTEL_PAYMENT_ALLOWED_HOST=payproxyapi.hubtel.com
HUBTEL_PAYMENT_ENDPOINT=https://payproxyapi.hubtel.com
HUBTEL_ENABLED_METHODS=MOMO,CARD,QR

# Paystack Credentials (if PAYMENT_PROVIDER=paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_ENABLED_METHODS=MOMO,CARD

# --- SMS Provider Selection ---
# Valid options: 'hubtel' | 'https_gateway' | 'none' | 'auto'
SMS_PROVIDER=none
SMS_GATEWAY_ENDPOINT=
SMS_GATEWAY_ALLOWED_HOST=
SMS_GATEWAY_TOKEN=
