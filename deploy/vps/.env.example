# Copy to project root .env.vps and protect with chmod 600. Never commit it.
ELESEND_API_HOST=api.your-elesend-domain.example
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DOCKER_DATABASE_URL=postgres://elesend:URLENCODE_PASSWORD@db:5432/elesend
OTP_KEY=REPLACE_WITH_64_HEX_CHARS
GOOGLE_ROUTES_API_KEY=
ROUTING_OSRM_URL=
ROUTING_OSRM_PROFILES_JSON={"car":"driving","motorcycle":"driving","pickup":"driving","van":"driving"}

# Restrict X-Forwarded-For trust to the controlled Caddy peer, if enabled.
# If unset, aggregate requests coming via the proxy share one IP throttle budget.
TRUSTED_PROXY_CIDRS=

# Optional 32+ char monitoring secret for GET /ready (header: X-Elesend-Health-Token).
READINESS_PROBE_TOKEN=

# Optional server-side PSP adapter. Leave blank to disable all digital payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_ENABLED_METHODS=MOMO,CARD
# QR checkout-link activation requires explicit PSP method configuration and
# admin approval; add QR to PAYSTACK_ENABLED_METHODS only when tested.

# Dedicated administrator MFA encryption key; do not reuse OTP_KEY.
ADMIN_MFA_ENCRYPTION_KEY=
# Dedicated administrative hostname isolation (e.g. admin.your-elesend-domain.example).
# Requests with mismatched Host header or public hostname return 404 for admin routes.
ADMIN_HOST=
# Validated provider-neutral HTTPS SMS transport; blank disables delivery OTP.
SMS_GATEWAY_ENDPOINT=
SMS_GATEWAY_ALLOWED_HOST=
SMS_GATEWAY_TOKEN=
