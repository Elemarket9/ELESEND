# Android emulator can reach the development tile service at 10.0.2.2:3145.
# Physical devices require an HTTPS URL on a host you control.
EXPO_PUBLIC_ELESEND_API_BASE_URL=https://your-secure-api-domain.example
EXPO_PUBLIC_ELESEND_VECTOR_TILE_URL=https://your-secure-map-domain.example/tiles/{z}/{x}/{y}.pbf
