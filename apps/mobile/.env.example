# Android emulator with API exposed through localhost emulator gateway; HTTPS on all physical devices.
EXPO_PUBLIC_ELESEND_API_BASE_URL=https://your-secure-api-domain.example
# Google Maps SDK keys for native app only. Restrict Android key by app package + signing fingerprints;
# restrict iOS key by bundle ID. NEVER insert GOOGLE_ROUTES_API_KEY here.
GOOGLE_ANDROID_MAPS_SDK_KEY=
GOOGLE_IOS_MAPS_SDK_KEY=
