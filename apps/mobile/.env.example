# ============================================================
# ELESEND MOBILE APPLICATION ENVIRONMENT (.env.example)
# ============================================================
# IMPORTANT:
# In React Native / Expo, all EXPO_PUBLIC_* variables are statically
# embedded into the application JavaScript bundle at build time.
#
# 1. Changing ANY variable below requires REBUILDING the bundle / binary:
#    - Development: npx expo start -c (clear cache)
#    - Android APK/AAB: npx expo run:android --variant release
#    - Web / Bundle: npx expo export
#
# 2. DO NOT PUT SECRETS HERE.
#    Never include database URLs, OTP keys, JWT signing keys, Hubtel
#    client secrets, or admin credentials. Any string here can be
#    extracted by inspecting the APK or web bundle.

# HTTPS Base URL of your backend API server (must include https:// for physical devices)
# Android emulator can reach the development host machine at http://10.0.2.2:3090
EXPO_PUBLIC_ELESEND_API_BASE_URL=https://api.elesend.com

# Vector Map Tile Server URL template (must be HTTPS for real devices)
# Android emulator can reach local tile server at http://10.0.2.2:3145/tiles/{z}/{x}/{y}.pbf
EXPO_PUBLIC_ELESEND_VECTOR_TILE_URL=https://maps.elesend.com/tiles/{z}/{x}/{y}.pbf

# Optional custom glyphs / fonts URL for MapLibre rendering
EXPO_PUBLIC_ELESEND_GLYPHS_URL=https://maps.elesend.com/fonts/{fontstack}/{range}.pbf
