DATABASE_URL=postgres://elesend:replace-me@127.0.0.1:5432/elesend
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_KEY=
PORT=3090
HOST=127.0.0.1
# Used only by admin:create; remove from environment afterward.
ADMIN_PHONE=
ADMIN_PASSWORD=
# Tests refuse databases whose name does not begin with elesend_test.
TEST_DATABASE_URL=postgres://elesend_test@127.0.0.1:55439/elesend_test
# Point at your own OSRM-compatible road-network service; do not use unapproved public demo endpoints.
# Quote operations fail closed unless a road-routing adapter is configured.
ROUTING_OSRM_URL=
# Independently extracted and validated graph services, e.g. car and motorcycle.
ROUTING_OSRM_VEHICLES_JSON=
# Mapping system only accepts OSRM. The included Ghana graph uses the car.lua profile.
ROUTING_PROVIDER_PRIORITY=osrm
ROUTING_OSRM_PROFILES_JSON={"car":"driving"}
# Directory outside the repository containing ghana.mbtiles, Ghana PBF and OSRM graph.
GHANA_MAP_DATA=C:/Users/sonofjacob/ghana-map-data
# Optional address-to-coordinate lookup; upstream free/unlimited use is not verified.
GHANAPOSTGPS_LOOKUP_ENABLED=false
GHANAPOSTGPS_LOOKUP_URL=https://ghanapostgps.sperixlabs.org
# Compose-specific; use strong non-production example placeholders in a private .env.
POSTGRES_PASSWORD=
DOCKER_DATABASE_URL=
# Prepaid commission credits require separate Ghana regulatory + provider approval; off by default.
ENABLE_PREPAID_CREDITS=false
# Real PSP settlement adapter MUST be developed and connected to financeService after provider due diligence.
# No live MoMo collection or automatic commission repayment exists without one.

# Reverse-proxy rate limit: blank = trust TCP peer only.
# Behind Caddy, set ONLY the IP/CIDR of the actual, exclusively controlled ingress proxy.
# Never trust arbitrary internet/LAN client X-Forwarded-For headers.
TRUSTED_PROXY_CIDRS=

# Optional server-only readiness probe secret (>=32 random characters). Never ship in mobile.
READINESS_PROBE_TOKEN=

# Optional provider-specific adapter, configured ONLY on the backend.
# Without approved credentials, all digital checkouts remain disabled.
# For production NODE_ENV=production the adapter refuses test credentials.
PAYSTACK_SECRET_KEY=
# Explicitly approved checkout types for merchant account; QR here means a
# scannable URL to hosted checkout (NOT a certified GhQR merchant payment code).
PAYSTACK_ENABLED_METHODS=MOMO,CARD,QR
# The PSP webhook URLs are /api/v1/payments/checkout-webhook and
# /api/v1/payments/commission-webhook. Configure HTTPS on the PSP dashboard.

# Administrative TOTP / authenticator security. Provision per administrator;
# never put the factor seed or master encryption key in mobile EXPO_PUBLIC_*.
# ADMIN_MFA_ENCRYPTION_KEY must be a DIFFERENT 32-byte random hex key from OTP_KEY.
ADMIN_MFA_ENCRYPTION_KEY=
# Used only by admin:create or admin-mfa-provision, remove after command completes.
ADMIN_TOTP_SECRET_BASE32=
# Optional, approved HTTPS SMS gateway adapter. Defaults to disabled / fail closed.
# Gateway must POST {to,message,clientReference}, return {accepted:true,messageId:"..."}.
SMS_GATEWAY_ENDPOINT=
SMS_GATEWAY_ALLOWED_HOST=
SMS_GATEWAY_TOKEN=
