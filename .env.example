# ============================================================
# ELESEND UNIFIED ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================
# Compatible with local development, Linux VPS, Docker Compose,
# and container cloud platforms (AWS ECS/Fargate, GCP Cloud Run,
# Render, Railway, Fly.io).

# ------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & PORT BINDING
# ------------------------------------------------------------
NODE_ENV=production
# Listening port: cloud platforms inject PORT dynamically (e.g. 8080, 10000)
PORT=3090
# Bind address: 0.0.0.0 in Docker / Cloud containers; 127.0.0.1 for local dev
HOST=0.0.0.0

# ------------------------------------------------------------
# 2. DOMAINS, ORIGINS & HOST ISOLATION
# ------------------------------------------------------------
# Base public HTTPS origin for API requests and PSP webhooks
API_PUBLIC_ORIGIN=https://api.yourdomain.example
# Base public HTTPS origin for web redirects (e.g. payment return, web tracking)
WEB_PUBLIC_ORIGIN=https://yourdomain.example
# Dedicated administrative hostname isolation (blocks /admin from public domain)
ADMIN_HOST=admin.yourdomain.example

# ------------------------------------------------------------
# 3. DATABASE & MANAGED CLOUD POSTGRESQL SSL
# ------------------------------------------------------------
# Dedicated PostgreSQL instance URL (PostGIS 3.x+ required)
DATABASE_URL=postgres://elesend:replace-me@127.0.0.1:5432/elesend
# Docker compose internal URL
DOCKER_DATABASE_URL=postgres://elesend:replace-me@db:5432/elesend
POSTGRES_PASSWORD=replace-with-secure-password
# Managed Cloud PostgreSQL SSL (AWS RDS, Neon, Supabase, Cloud SQL, Railway, Render)
# Set to 'true' or append '?sslmode=require' to DATABASE_URL.
DATABASE_SSL=false
# Set to 'false' ONLY if using cloud self-signed certificates without custom CA
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional custom PEM CA certificate for PostgreSQL TLS
DATABASE_SSL_CA=

# Tests refuse databases whose name does not begin with elesend_test
TEST_DATABASE_URL=postgres://elesend_test@127.0.0.1:5433/elesend_test

# ------------------------------------------------------------
# 4. SECURITY & CRYPTOGRAPHY KEYS
# ------------------------------------------------------------
# Delivery OTP HMAC master key (64 hex characters / 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_KEY=
# Admin MFA AES-256 master encryption key (must be a DIFFERENT 64 hex characters)
ADMIN_MFA_ENCRYPTION_KEY=
# Session JWT signing secret (minimum 32 characters, unique)
JWT_SECRET=
# Dedicated admin account master key (minimum 32 characters, unique)
ADMIN_MASTER_KEY=
# Tamper-evident immutable audit log signing secret (minimum 32 characters, unique)
AUDIT_LOG_SECRET=
# Background job execution (true for single VPS / worker; false for auto-scaled API pods)
BACKGROUND_JOBS_ENABLED=true
# Reverse-proxy rate limit: IP/CIDR of exclusively controlled ingress proxy (e.g. Caddy/Nginx/ALB)
TRUSTED_PROXY_CIDRS=
# Optional server-only readiness probe secret (>=32 random characters)
READINESS_PROBE_TOKEN=

# ------------------------------------------------------------
# 5. ROAD ROUTING & OSRM GRAPH ENDPOINTS
# ------------------------------------------------------------
# Path to host directory containing ghana.mbtiles and OSRM graph data
GHANA_MAP_DATA=/var/data/ghana-map-data
# Single OSRM endpoint fallback (for dev or when single graph supports multiple vehicles)
ROUTING_OSRM_URL=http://127.0.0.1:5000
# Independent graph endpoints per vehicle profile (recommended for production)
ROUTING_OSRM_MOTORCYCLE_URL=
ROUTING_OSRM_CAR_URL=
# Or supply full JSON mapping: '{"car":"http://...","motorcycle":"http://..."}'
ROUTING_OSRM_VEHICLES_JSON=
ROUTING_ALLOW_SINGLE_ENDPOINT=false
ROUTING_PROVIDER_PRIORITY=osrm
ROUTING_OSRM_PROFILES_JSON={"car":"driving","motorcycle":"driving"}
# Optional GhanaPostGPS API lookup
GHANAPOSTGPS_LOOKUP_ENABLED=false
GHANAPOSTGPS_LOOKUP_URL=https://ghanapostgps.sperixlabs.org

# ------------------------------------------------------------
# 6. PAYMENT PROVIDER (HUBTEL / PAYSTACK)
# ------------------------------------------------------------
# Select an installed adapter explicitly; no credential-based auto switching in production.
# 'gateway' connects a deployment-owned bridge to any contracted PSP. 'none' disables payments.
PAYMENT_PROVIDER=none

# Hubtel Ghana Credentials (Official MoMo, Card & QR checkout)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
HUBTEL_PAYMENT_ALLOWED_HOST=payproxyapi.hubtel.com
HUBTEL_PAYMENT_ENDPOINT=https://payproxyapi.hubtel.com
HUBTEL_ENABLED_METHODS=MOMO,CARD,QR
# If omitted, defaults to API_PUBLIC_ORIGIN and WEB_PUBLIC_ORIGIN
HUBTEL_CALLBACK_BASE_URL=
HUBTEL_RETURN_BASE_URL=
HUBTEL_CANCELLATION_BASE_URL=
SETTLEMENT_HUBTEL_RECEIVING_ACCOUNT=
SETTLEMENT_HUBTEL_PROVIDER_CHANNEL=

# Paystack (Alternative digital checkout adapter)
PAYSTACK_SECRET_KEY=
PAYSTACK_ENABLED_METHODS=MOMO,CARD,QR
SETTLEMENT_PAYSTACK_RECIPIENT_TYPE=
SETTLEMENT_PAYSTACK_PROVIDER_CHANNEL=

# ------------------------------------------------------------
# 7. SMS GATEWAY PROVIDER (HUBTEL / HTTPS GATEWAY)
# ------------------------------------------------------------
# Explicit provider selection: 'hubtel' | 'https_gateway' | 'none' | 'auto'
SMS_PROVIDER=hubtel
HUBTEL_SENDER_ID=ELESEND
HUBTEL_SMS_ENDPOINT=https://api.hubtel.com/v1/messages/send

# Optional generic HTTPS SMS gateway
SMS_GATEWAY_ENDPOINT=
SMS_GATEWAY_ALLOWED_HOST=
SMS_GATEWAY_TOKEN=

# ------------------------------------------------------------
# 8. FEATURES & PLATFORM FLAGS
# ------------------------------------------------------------
ENABLE_PREPAID_CREDITS=false
# Optional approved SMS/push bridge for durable rider offers and settlement notices.
# POST {id,recipientId,phone,kind,...payload}; deduplicate Idempotency-Key.
# Return {accepted:true,messageId:"provider-receipt"} after durable acceptance.
# Requests carry Bearer auth and X-Elesend-Signature (HMAC-SHA256 of raw JSON).
NOTIFICATION_GATEWAY_ENDPOINT=
NOTIFICATION_GATEWAY_ALLOWED_HOST=
NOTIFICATION_GATEWAY_TOKEN=

# Provider-neutral payment bridge (server-only credentials)
PAYMENT_GATEWAY_NAME=
PAYMENT_GATEWAY_ENDPOINT=
PAYMENT_GATEWAY_ALLOWED_HOST=
PAYMENT_GATEWAY_TOKEN=
PAYMENT_GATEWAY_CHECKOUT_HOSTS=
PAYMENT_GATEWAY_METHODS=MOMO,CARD,QR
PAYMENT_PAYER_FIELDS=
FOOD_ACCEPTANCE_TIMEOUT_SECONDS=300
FOOD_COURIER_TIMEOUT_SECONDS=1200
FOOD_PAYMENT_TIMEOUT_SECONDS=1800
